# Copy to .env (git-ignored) and fill in. Read by the mail middleware in server/ (mounted by vite.config.ts); never exposed to the browser.

# Where demo requests are delivered
MAIL_TO=j.burhan@consulttechies.com

# Mailbox the message is sent from
MAIL_FROM=

# Optional: copy every request to this address
CC_EMAIL=

# Azure app registration (client-credentials flow)
AZURE_TENANT=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=


